#!/bin/bash
# Keyboard backlight settings: manual brightness, auto-dim on/off, the dim
# level, and the idle timeout before it kicks in.
#
# Usage:
#   omarchy-kbd-backlight brightness <percent>|status
#   omarchy-kbd-backlight dim-percent <percent>|status
#   omarchy-kbd-backlight timeout <seconds>|status
#   omarchy-kbd-backlight auto-dim on|off|toggle|status

CONF_DIR="$HOME/.config/omarchy"
CONF_FILE="$CONF_DIR/kbd-backlight.conf"
STATE_DIR="$HOME/.local/state/omarchy/indicators"
DISABLED_FILE="$STATE_DIR/kbd-backlight-dim-disabled"
HYPRIDLE_CONF="$HOME/.config/hypr/hypridle.conf"
HOOK="$HOME/.local/bin/omarchy-kbd-backlight-idle-hook"
DEVICE="kbd_backlight"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
SERVICE_UNIT="$SYSTEMD_USER_DIR/omarchy-kbd-backlight.service"
SERVICE_NAME="omarchy-kbd-backlight.service"
WATCHDOG_SERVICE_UNIT="$SYSTEMD_USER_DIR/omarchy-kbd-backlight-watchdog.service"
WATCHDOG_TIMER_UNIT="$SYSTEMD_USER_DIR/omarchy-kbd-backlight-watchdog.timer"
RESUME_WATCH_UNIT="$SYSTEMD_USER_DIR/omarchy-kbd-backlight-resume-watch.service"
RESUME_WATCH_SCRIPT="$HOME/.local/bin/omarchy-kbd-backlight-resume-watch"

mkdir -p "$CONF_DIR"
[[ -f $CONF_FILE ]] || printf 'IDLE_SECONDS=10\nDIM_PERCENT=0\n' > "$CONF_FILE"
# shellcheck disable=SC1090
source "$CONF_FILE"
IDLE_SECONDS="${IDLE_SECONDS:-10}"
DIM_PERCENT="${DIM_PERCENT:-0}"

save_conf() {
  cat > "$CONF_FILE" <<EOF
IDLE_SECONDS=$IDLE_SECONDS
DIM_PERCENT=$DIM_PERCENT
EOF
}

regenerate_hypridle() {
  cat > "$HYPRIDLE_CONF" <<EOF
# Keyboard backlight auto-dim. Managed by omarchy-kbd-backlight -- edit via
# 'omarchy-kbd-backlight timeout <seconds>' (or the Omarchy menu) rather
# than by hand; this file gets regenerated.
#
# ignore_dbus_inhibit / ignore_wayland_inhibit: without these, a video or
# call in a browser (Brave, Firefox, a Discord tab, etc.) holds a dbus or
# Wayland idle-inhibit lock that silently blocks this whole hypridle
# instance, so the keyboard never dims while it's active. Safe to ignore
# here because this instance only dims the keyboard backlight -- screen
# lock/screensaver is handled separately by the Omarchy shell.
general {
  ignore_dbus_inhibit = true
  ignore_systemd_inhibit = true
  ignore_wayland_inhibit = true
}

listener {
  timeout = $IDLE_SECONDS
  on-timeout = $HOOK dim
  on-resume = $HOOK restore
}
EOF

  mkdir -p "$SYSTEMD_USER_DIR"
  if [[ ! -f $SERVICE_UNIT ]]; then
    cat > "$SERVICE_UNIT" <<EOF
[Unit]
Description=Keyboard backlight auto-dim (Omarchy)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hypridle -c %h/.config/hypr/hypridle.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
EOF
    systemctl --user daemon-reload
  fi
  systemctl --user enable --now "$SERVICE_NAME" >/dev/null
  systemctl --user restart "$SERVICE_NAME"
  ensure_watchdog
  ensure_resume_watch
}

# hypridle's Wayland idle-notifier connection can silently wedge (seen in the
# wild right after a Hyprland session lock/unlock cycle): the process stays
# alive and "active" per systemd, but stops seeing any input activity at all,
# so the keyboard backlight gets stuck dimmed forever. There is no reliable
# signal to detect that from outside, so instead of trying to catch the exact
# trigger, just restart the instance periodically -- cheap (well under a
# second, no visible effect) and guarantees it can never stay wedged for more
# than one interval.
#
# The restart itself can land while the keyboard happens to be dimmed. The
# fresh hypridle instance starts out assuming it's not idle, so if the user
# is actively typing right through the restart (the common case -- that's
# often what triggers it), there's no idle->active transition left to fire
# on-resume, and the backlight would stay stuck dark indefinitely. Forcing a
# restore right after the restart closes that gap; it's a no-op if the
# keyboard wasn't dimmed.
ensure_watchdog() {
  mkdir -p "$SYSTEMD_USER_DIR"
  # Unconditionally rewritten (unlike the other unit files below) since its
  # ExecStart has already had to change once to fix the stuck-dark bug above
  # -- a version gate here would silently strand existing installs on the
  # old, buggy unit every time they update.
  cat > "$WATCHDOG_SERVICE_UNIT" <<EOF
[Unit]
Description=Restart keyboard backlight auto-dim if it has wedged (Omarchy)

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'systemctl --user restart omarchy-kbd-backlight.service && $HOOK restore'
EOF
  systemctl --user daemon-reload
  if [[ ! -f $WATCHDOG_TIMER_UNIT ]]; then
    cat > "$WATCHDOG_TIMER_UNIT" <<EOF
[Unit]
Description=Periodically restart keyboard backlight auto-dim if it has wedged (Omarchy)

[Timer]
OnUnitActiveSec=15min
OnStartupSec=15min

[Install]
WantedBy=timers.target
EOF
  fi
  systemctl --user enable --now omarchy-kbd-backlight-watchdog.timer >/dev/null
}

# The 15-minute watchdog above guarantees the wedge above never lasts long,
# but a suspend/resume cycle is by far the most common trigger for it (see
# ensure_watchdog), and there's no reason to make a user wait up to 15
# minutes after opening the lid for their keyboard to light up again. This
# listens for logind's resume signal directly and restarts the service the
# moment it fires, closing that gap to effectively instant. The watchdog
# stays in place as a fallback for wedges from other causes.
ensure_resume_watch() {
  mkdir -p "$SYSTEMD_USER_DIR"
  if [[ ! -f $RESUME_WATCH_UNIT ]]; then
    cat > "$RESUME_WATCH_UNIT" <<EOF
[Unit]
Description=Restart keyboard backlight auto-dim immediately on resume (Omarchy)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=$RESUME_WATCH_SCRIPT
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
EOF
    systemctl --user daemon-reload
  fi
  systemctl --user enable --now omarchy-kbd-backlight-resume-watch.service >/dev/null
}

brightness_percent() {
  local cur max
  cur=$(brightnessctl -d "$DEVICE" g)
  max=$(brightnessctl -d "$DEVICE" m)
  echo $(( cur * 100 / max ))
}

case "$1" in
  brightness)
    case "$2" in
      status) brightness_percent ;;
      *) brightnessctl -d "$DEVICE" set "${2}%" >/dev/null && echo "$2" ;;
    esac
    ;;
  dim-percent)
    case "$2" in
      status) echo "$DIM_PERCENT" ;;
      *) DIM_PERCENT="$2"; save_conf; echo "$DIM_PERCENT" ;;
    esac
    ;;
  timeout)
    case "$2" in
      status) echo "$IDLE_SECONDS" ;;
      *) IDLE_SECONDS="$2"; save_conf; regenerate_hypridle; echo "$IDLE_SECONDS" ;;
    esac
    ;;
  auto-dim)
    case "$2" in
      on|enable) rm -f "$DISABLED_FILE"; echo enabled ;;
      off|disable) mkdir -p "$STATE_DIR"; touch "$DISABLED_FILE"; "$HOOK" restore; echo disabled ;;
      toggle)
        if [[ -f $DISABLED_FILE ]]; then rm -f "$DISABLED_FILE"; echo enabled
        else mkdir -p "$STATE_DIR"; touch "$DISABLED_FILE"; "$HOOK" restore; echo disabled
        fi
        ;;
      *) [[ -f $DISABLED_FILE ]] && echo disabled || echo enabled ;;
    esac
    ;;
  *)
    echo "Usage: omarchy-kbd-backlight {brightness|dim-percent|timeout|auto-dim} <value|status>" >&2
    exit 1
    ;;
esac
